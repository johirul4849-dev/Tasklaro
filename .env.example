# Environment Configuration for Local and Vercel Production

# GEMINI_API_KEY: Required for Gemini AI task execution.
# (Also supported aliases on Vercel: GOOGLE_API_KEY, GOOGLE_GENAI_API_KEY, VITE_GEMINI_API_KEY)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional production URL where the app is hosted (e.g. https://your-project.vercel.app)
APP_URL="MY_APP_URL"
